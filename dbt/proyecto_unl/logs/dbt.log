  create  table "db_warehouse"."public"."fct_resumen_clima__dbt_tmp"
  
  
    as
  
  (
    



WITH staging AS (
    SELECT * FROM "db_warehouse"."public"."stg_clima"
)

SELECT 
    nombre_ciudad,
    
ROUND((temp_celsius * 9.0 / 5.0) + 32.0, 2)
 AS temp_fahrenheit,
    
    SUM(CASE WHEN condicion_climatica = 'Soleado' THEN 1 ELSE 0 END) AS dias_soleado
     , 
    
    SUM(CASE WHEN condicion_climatica = 'Nublado' THEN 1 ELSE 0 END) AS dias_nublado
     , 
    
    SUM(CASE WHEN condicion_climatica = 'Caluroso' THEN 1 ELSE 0 END) AS dias_caluroso
     , 
    
    SUM(CASE WHEN condicion_climatica = 'Lluvia' THEN 1 ELSE 0 END) AS dias_lluvia
     , 
    
    SUM(CASE WHEN condicion_climatica = 'Tormentoso' THEN 1 ELSE 0 END) AS dias_tormentoso
    
    
FROM staging
GROUP BY nombre_ciudad, temp_celsius
  );
  
